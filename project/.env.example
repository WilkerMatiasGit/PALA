# DLab — variáveis de ambiente
# Copie este ficheiro para `.env` na raiz do projeto e preencha com os teus dados.

# Ligação MySQL para o Prisma
# Formato: mysql://UTILIZADOR:SENHA@HOST:PORTA/NOME_BASE?connection_limit=5
# Exemplo:
#   mysql://root:minha_senha@localhost:3306/dlab
DATABASE_URL="mysql://root:SUA_SENHA@localhost:3306/dlab"

# Servidor
PORT=4000
# Em produção, defina um segredo forte
JWT_SECRET=dlab-dev-secret-change-in-production