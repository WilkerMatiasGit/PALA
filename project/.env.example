# DLab — variáveis de ambiente
# Copie este ficheiro para `.env` na raiz do projeto e preencha com os teus dados.

# Ligação Postgres (E3) — dev local (Postgres 16) e staging (Neon) usam ambos `postgresql://`.
# No Neon usa a POOLED connection string (termina em -pooler.… e tem ?sslmode=require).
# Exemplos:
#   Local:  postgresql://dlab:senha@localhost:5432/dlab
#   Neon:   postgresql://user:pass@ep-xxxx-pooler.eu-central-1.aws.neon.tech/dlab?sslmode=require
DATABASE_URL="postgresql://USER:SENHA@HOST:PORTA/dlab"

# (Opcional) URL DIRECT só para migrações Prisma — Neon: sem pooler.
# DIRECT_URL="postgresql://user:pass@ep-xxxx.eu-central-1.aws.neon.tech/dlab?sslmode=require"

# Servidor
PORT=4000
# Em produção, defina um segredo forte (o código não deve ter fallback).
JWT_SECRET=dlab-dev-secret-change-in-production
# Origens CORS extra (para além de localhost e *.vercel.app), separadas por vírgula.
# CORS_ORIGINS="https://app.exemplo.ao"

# Deploy Vercel (npm run deploy). VERCEL_TOKEN é obrigatório; os ORG/PROJECT id
# são opcionais localmente (o CLI usa .vercel/project.json) e úteis para CI.
# VERCEL_TOKEN="xxxx"
# VERCEL_ORG_ID="xxxx"
# VERCEL_PROJECT_ID="prj_xxxx"